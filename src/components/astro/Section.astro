---
interface Props {
  id: string;
  title?: string;
  class?: string;
}
const { id, title, class: className = '' } = Astro.props;
---

<section id={id} class={`relative z-10 scroll-mt-20 py-20 sm:py-28 ${className}`}>
  <div class="mx-auto max-w-6xl px-5">
    {
      title && (
        <h2 class="title-bar reveal mb-12 text-3xl font-bold sm:text-4xl">
          {title}
        </h2>
      )
    }
    <slot />
  </div>
</section>
