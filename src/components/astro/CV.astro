---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import type { LocaleData } from '../../data/types';

interface Props {
  data: LocaleData;
}
const { data } = Astro.props;
const { experience, education, languages, ui } = data;
---

<Section id="cv" title={ui.sections.cv}>
  <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
    <!-- Education + side info -->
    <div class="space-y-10">
      <div class="reveal">
        <h3 class="mb-6 text-xl font-semibold text-[--color-accent-bright]">
          {ui.sections.education}
        </h3>
        <ul class="space-y-6 border-l border-[--color-panel-border] pl-6">
          {
            education.map((e) => (
              <li class="relative">
                <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full bg-[--color-accent] ring-4 ring-[--color-space]" />
                <p class="text-xs font-semibold uppercase tracking-wide text-[--color-accent]">
                  {e.year}
                </p>
                <h4 class="mt-1 font-medium">{e.title}</h4>
                <p class="text-sm text-[--color-ink-soft]">{e.org}</p>
                {e.certificateUrl && (
                  <a
                    href={e.certificateUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1 inline-flex items-center gap-1 text-sm text-[--color-accent-bright] hover:underline"
                  >
                    <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
                    {ui.buttons.viewCertificate}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal">
        <h3 class="mb-4 text-xl font-semibold text-[--color-accent-bright]">
          {ui.sections.languages}
        </h3>
        <ul class="space-y-2">
          {
            languages.map((l) => (
              <li class="flex items-center justify-between rounded-lg bg-white/4 px-4 py-2 text-sm">
                <span class="font-medium">{l.name}</span>
                <span class="text-[--color-ink-soft]">{l.level}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 flex items-center gap-2 text-sm text-[--color-ink-soft]">
          <Icon name="lucide:gamepad-2" class="h-4 w-4 text-[--color-accent-bright]" />
          <span>{ui.interests.sport}: Ping Pong</span>
        </div>
      </div>
    </div>

    <!-- Experience timeline -->
    <div class="reveal">
      <h3 class="mb-6 text-xl font-semibold text-[--color-accent-bright]">
        {ui.sections.experience}
      </h3>
      <ul class="space-y-4 border-l border-[--color-panel-border] pl-6">
        {
          experience.map((job) => (
            <li class="relative">
              <span class="absolute -left-[31px] top-2 h-3 w-3 rounded-full bg-[--color-accent-purple] ring-4 ring-[--color-space]" />
              <details class="group glass rounded-xl p-4 transition-colors hover:border-[--color-accent]/40">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-3">
                  <div>
                    <h4 class="font-semibold">{job.title}</h4>
                    <p class="text-sm text-[--color-accent-bright]">{job.company}</p>
                    <p class="text-xs text-[--color-ink-soft]">
                      {job.location} · {job.period}
                    </p>
                  </div>
                  <Icon
                    name="lucide:chevron-down"
                    class="mt-1 h-5 w-5 shrink-0 text-[--color-ink-soft] transition-transform group-open:rotate-180"
                  />
                </summary>
                <ul class="mt-3 space-y-1.5 border-t border-white/5 pt-3 text-sm text-[--color-ink-soft]">
                  {job.bullets.map((b) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[--color-accent]" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
